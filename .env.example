# Server configuration
PORT=3000
NODE_ENV=development

# Database connection (e.g. mysql://user:pass@host:3306/db)
# If omitted, an in-memory mock catalog is used automatically
DATABASE_URL=

# Authentication & Session
JWT_SECRET=
OWNER_OPEN_ID=
OAUTH_SERVER_URL=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# Gemini API (Server-side)
GEMINI_API_KEY=
